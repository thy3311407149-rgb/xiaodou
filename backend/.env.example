APP_ENV=development
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=20971520
PORT=3000
# Local default. Set HOST=0.0.0.0 when the server must accept connections from outside its container.
HOST=127.0.0.1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.2
# Exact browser origins, separated by commas. Leave empty until the APK WebView origin is confirmed.
# Values containing * are ignored. Example after confirmation: https://localhost
CORS_ALLOWED_ORIGINS=
